# ==========================================
# Coding Platform Frontend Configuration
# ==========================================

# Base API URL of your backend.
# In development: http://localhost:5000/api
# In production on separate domain (e.g. Vercel frontend + Render backend): https://your-backend.onrender.com/api
# If deployed on the same domain or served directly by the backend: leave empty (defaults to /api)
VITE_API_URL=http://localhost:5000/api

# Optional: Base Socket.IO server URL (defaults to VITE_API_URL host or current origin)
# VITE_SOCKET_URL=http://localhost:5000
