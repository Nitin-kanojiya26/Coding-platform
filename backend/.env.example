# ==========================================
# Coding Platform Backend Configuration
# ==========================================

# Port the backend server listens on (Render/Railway sets PORT automatically)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=production

# Client URLs allowed for CORS and WebSockets (comma-separated for multiple domains)
# Example: https://codearena.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Optional: Set to 'true' if the backend should serve the built frontend directly from frontend/dist
SERVE_FRONTEND=false

# MongoDB Connection String (Atlas / Railway / local)
MONGO_URI=mongodb://127.0.0.1:27017/coding-platform

# Secure random JWT secret for session token verification
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Redis Connection (Redis Cloud / Upstash / local)
REDIS_URL=redis://127.0.0.1:6380

# Judge0 Code Execution Engine URL
JUDGE0_API_URL=http://localhost:2358

# Email Service (Nodemailer credentials for OTP verification & invitations)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Submission Engine Configuration ('queue' for BullMQ async with Redis, 'sync' for synchronous execution)
SUBMIT_MODE=queue
WORKER_CONCURRENCY=5
USE_CACHE=true
DISABLE_RATE_LIMIT=false

# Build Mode Sandbox Images (optional, defaults to prebuilt bm images)
BM_APP_IMAGE=bm-node-express
BM_HARNESS_IMAGE=bm-harness
BM_CONCURRENCY=2
